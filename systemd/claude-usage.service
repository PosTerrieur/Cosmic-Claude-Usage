[Unit]
Description=Mise à jour des statistiques d'utilisation Claude
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/fetch-claude-usage
# Chemin absolu vers Python si nécessaire :
# ExecStart=/usr/bin/python3 %h/.local/share/cosmic-claude-usage/fetch_usage.py
StandardOutput=journal
StandardError=journal
