# ~/.config/claude-usage/config.env

# ── Authentification ──────────────────────────────────────────────────────────
# Copiez la valeur du cookie "sessionKey" depuis les DevTools de votre navigateur.
#
# Firefox : F12 → Stockage → Cookies → https://claude.ai → sessionKey
# Chrome  : F12 → Application → Cookies → https://claude.ai → sessionKey
#
SESSION_KEY=sk-ant-sid01-VOTRE_CLE_ICI

# ── Quotas (ajustez selon votre plan) ────────────────────────────────────────
# Plan gratuit  ≈  20–40 messages / ~8h
# Plan Pro      ≈ 100+  messages / ~8h (en messages, pas en tokens)
#
# HEBDO_LIMIT  : max messages avant reset (lu depuis rate_limit_status,
#                cette valeur sert de fallback si l'API ne répond pas)
HEBDO_LIMIT=40

# SESSION_LIMIT : nombre de messages que vous considérez comme "une session"
#                 (seuil personnel, pas imposé par Anthropic)
SESSION_LIMIT=10
